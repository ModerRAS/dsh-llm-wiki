{
  "name": "dsh-llm-wiki",
  "version": "0.6.5",
  "description": "LLM Wiki as a native DeepSeek Harness plugin — self-maintaining, Obsidian-compatible knowledge base.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-wiki",
    "knowledge-base",
    "obsidian",
    "wiki"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host-index.js",
  "exports": {
    ".": "./host-index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host-index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "dist"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "mdast-util-from-markdown": "~2.1.0",
    "node-html-markdown": "^2.0.0",
    "typebox": "1.3.34",
    "yaml": "~2.9.1"
  },
  "optionalDependencies": {
    "@tobilu/qmd": "2.8.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
